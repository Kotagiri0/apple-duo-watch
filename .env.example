# Token from @BotFather. Keep it out of git — .env is ignored.
TELEGRAM_BOT_TOKEN=

# Chat to notify. Leave empty and send /start to the bot: the first sender
# is adopted and stored in the state file. This chat is the owner: it always
# commands the bot and cannot be removed from the access list. Findings go to
# the owner and to every admin below.
TELEGRAM_CHAT_ID=

# Anyone else allowed to command the bot, comma separated: numeric chat ids
# and/or @handles. A handle is only an invitation — the Bot API cannot turn
# one into an id, so access opens when that person first writes to the bot,
# and is then pinned to their numeric id. That matters: a Telegram handle can
# be given up and claimed by somebody else, an id cannot.
# Admins can run every command, including /pause, can admit or remove other
# admins, and receive the findings alongside the owner. A finding counts as
# delivered when at least one of them takes it, so one person having blocked
# the bot cannot make the rest lose the news. Strangers are ignored in silence.
# e.g. TELEGRAM_ADMINS=@example_handle,123456789
# Use a placeholder here, never a real account: this line gets copied
# into a live .env, and an invitation fires the moment that person writes.
TELEGRAM_ADMINS=

# HTTP proxy used for Telegram only (Apple is always fetched directly).
# Needed where api.telegram.org is blocked. On the deployed NanoPi this is the
# VPS-side tinyproxy reached through deploy/telegram-tunnel.service.
TELEGRAM_PROXY=

# Second channel, posted to alongside Telegram. Useful as a fallback when the
# tunnel is down, since a change that reaches no channel is retried but an
# outage still delays it. Any ntfy topic URL works, e.g. https://ntfy.sh/<topic>
# Anyone who knows the topic name can read it, so pick an unguessable one.
NTFY_URL=
NTFY_TOKEN=

# Seconds between checks. The deployment runs at 10, which is aggressive:
# Apple rate-limits by source IP, and a block makes the watcher blind. Each
# cycle subtracts its own request time, so the period is the interval itself.
INTERVAL_SECONDS=10

# In-store pickup is a second request per cycle, so it runs every Nth cycle.
# Left empty it works out to roughly once a minute at any interval.
PICKUP_EVERY=

# City used for in-store pickup lookups. "Dubai" covers all five UAE stores.
# Set to an empty value to skip pickup checks entirely.
CITY=Dubai

# Always alert while any SKU ships on or before this date (YYYY-MM-DD).
# Leave empty to only report changes relative to the previous check.
ALERT_BEFORE=2026-12-31

# Narrow the watch to specific part numbers, comma separated. Empty = all 8.
# e.g. ONLY_PARTS=MK244AH/A,MK254AH/A
ONLY_PARTS=

# Seconds of unbroken failure that count as "gone blind". Crossing the
# threshold sends one warning per incident — not one per cycle — and clearing
# it sends a separate "watching again". Measured in time rather than cycles,
# so the error backoff cannot stretch it.
BLIND_AFTER_SECONDS=600

# Pinged after every successful cycle. A watchdog living inside this process
# cannot report that the process itself died or that the machine was switched
# off, so something outside has to notice the pings stopping. On this
# deployment that is the heartbeat sink on the proxy VPS, reached through the
# same SSH tunnel (deploy/vps-install.sh). Any public healthcheck service with
# a dead man's switch works too — mind its request quota if you use one.
HEALTHCHECK_URL=http://172.17.0.1:8899/beat

# At most one ping per this many seconds, so a 10-second interval does not
# turn into 8640 requests a day. 60 is plenty for a sink of your own.
HEALTHCHECK_EVERY_SECONDS=60
