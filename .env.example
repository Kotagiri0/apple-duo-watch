# Token from @BotFather. Keep it out of git — .env is ignored.
TELEGRAM_BOT_TOKEN=

# Chat to notify. Leave empty and send /start to the bot: the first sender
# is adopted and stored in the state file.
TELEGRAM_CHAT_ID=

# HTTP proxy used for Telegram only (Apple is always fetched directly).
# Needed where api.telegram.org is blocked. On the deployed NanoPi this is the
# VPS-side tinyproxy reached through deploy/telegram-tunnel.service.
TELEGRAM_PROXY=

# Second channel, posted to alongside Telegram. Useful as a fallback when the
# tunnel is down, since a change that reaches no channel is retried but an
# outage still delays it. Any ntfy topic URL works, e.g. https://ntfy.sh/<topic>
# Anyone who knows the topic name can read it, so pick an unguessable one.
NTFY_URL=
NTFY_TOKEN=

# Seconds between checks. The deployment runs at 10, which is aggressive:
# Apple rate-limits by source IP, and a block makes the watcher blind. Each
# cycle subtracts its own request time, so the period is the interval itself.
INTERVAL_SECONDS=10

# In-store pickup is a second request per cycle, so it runs every Nth cycle.
# Left empty it works out to roughly once a minute at any interval.
PICKUP_EVERY=

# City used for in-store pickup lookups. "Dubai" covers all five UAE stores.
# Set to an empty value to skip pickup checks entirely.
CITY=Dubai

# Always alert while any SKU ships on or before this date (YYYY-MM-DD).
# Leave empty to only report changes relative to the previous check.
ALERT_BEFORE=2026-12-31

# Narrow the watch to specific part numbers, comma separated. Empty = all 8.
# e.g. ONLY_PARTS=MK244AH/A,MK254AH/A
ONLY_PARTS=
