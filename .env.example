# Token from @BotFather. Keep it out of git — .env is ignored.
TELEGRAM_BOT_TOKEN=

# Chat to notify. Leave empty and send /start to the bot: the first sender
# is adopted and stored in the state file.
TELEGRAM_CHAT_ID=

# Seconds between checks. 60 is what this deployment targets; below ~30 Apple
# starts rate-limiting the source IP.
INTERVAL_SECONDS=60

# City used for in-store pickup lookups. "Dubai" covers all five UAE stores.
# Set to an empty value to skip pickup checks entirely.
CITY=Dubai

# Always alert while any SKU ships on or before this date (YYYY-MM-DD).
# Leave empty to only report changes relative to the previous check.
ALERT_BEFORE=2026-12-31

# Narrow the watch to specific part numbers, comma separated. Empty = all 8.
# e.g. ONLY_PARTS=MK244AH/A,MK254AH/A
ONLY_PARTS=
