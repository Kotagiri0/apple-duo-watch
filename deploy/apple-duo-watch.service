# Systemd unit for a plain (non-Docker) deployment.
#   sudo cp deploy/apple-duo-watch.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now apple-duo-watch
[Unit]
Description=Watch Apple UAE for iPhone Duo availability
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=duo
WorkingDirectory=/opt/apple-duo-watch
EnvironmentFile=/opt/apple-duo-watch/.env
Environment=STATE_FILE=/var/lib/apple-duo-watch/state.json
ExecStart=/usr/bin/python3 -I /opt/apple-duo-watch/watcher.py
Restart=always
RestartSec=10
StateDirectory=apple-duo-watch
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
