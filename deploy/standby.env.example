# Second watcher, run on a host with a different address than the primary.
# Its job is insurance: if Apple rate-limits the primary's IP, that primary
# keeps running but stops succeeding, its heartbeat goes stale, and this
# instance starts alerting from its own address.
ROLE=standby

# How this instance reads the primary's last successful poll. Any command that
# prints an ISO timestamp on stdout works. On the deployed pair it is an ssh
# call restricted on the primary to exactly this one command, with no shell:
#   authorized_keys: restrict,command="/usr/local/bin/duo-heartbeat" ssh-ed25519 …
PRIMARY_HEARTBEAT_CMD=ssh -p 2222 -i /root/.ssh/read_primary -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=15 root@PRIMARY_HOST

# Take over once the primary's last successful poll is this old, and how often
# to read the heartbeat. Three unreadable reads in a row also count as quiet.
PRIMARY_STALE_SECONDS=300
PRIMARY_CHECK_EVERY=60

# The same bot, so the owner gets the alerts in the same chat. While the
# primary is alive this instance never calls getUpdates — both polling would
# steal each other's commands — so it serves no commands until it takes over.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMINS=

# Leave empty unless Telegram is blocked here too. On a host outside the
# primary's network it usually is not, and a direct call is one hop fewer.
TELEGRAM_PROXY=

# Must NOT be the primary's heartbeat sink: this instance pinging it would
# make a dead primary look alive. Give it its own, or leave it unset.
HEALTHCHECK_URL=

# Half the primary's rate: in reserve it only has to stay warm, and this is a
# second address hitting the same endpoint.
INTERVAL_SECONDS=30
CITY=Dubai
ALERT_BEFORE=2026-12-31
NTFY_URL=
NTFY_TOKEN=
STATE_FILE=/data/state.json
