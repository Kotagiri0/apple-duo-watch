# Alert channels for the outside watchdog on the proxy VPS, copied to
# /etc/duo-deadman.env by deploy/vps-install.sh. Copy this to
# deploy/vps-deadman.env (git-ignored) and fill it in.

# The same ntfy topic the watcher posts to, so this alert lands next to the
# others. Reachable from the VPS and from the watcher's network alike.
NTFY_URL=
NTFY_TOKEN=

# Optional, and the genuinely independent path: this machine reaches
# api.telegram.org directly, without the tunnel, so an alert from here arrives
# even when the tunnel is exactly what broke. The cost is a second copy of the
# bot token, on a second machine, to rotate if it ever leaks. Leave empty to
# alert over ntfy only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Seconds of silence before shouting. The watcher beats once a minute, so 900
# is fifteen missed beats — long enough to ride out a reboot or a short
# network blip, short enough to notice within the quarter hour.
STALE_AFTER=900
